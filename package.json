{
  "name": "number-slot",
  "version": "0.1.0",
  "private": true,
  "description": "Ukrainian state plate slot game (prototype)",
  "scripts": {
    "copy:web": "node -e \"const fs=require('fs');fs.mkdirSync('www',{recursive:true});fs.copyFileSync('index.html','www/index.html')\"",
    "add:android": "npm run copy:web && npx cap add android",
    "sync": "npm run copy:web && npx cap sync",
    "open:android": "npx cap open android"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/core": "^6.1.2"
  }
}
